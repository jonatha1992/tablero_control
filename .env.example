# =============================================================================
# TABLERO DE CONTROL — Variables de entorno
# Copiá este archivo a .env.local y completá los valores
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase (client-side — ya tienen fallbacks hardcodeados en client.ts)
# Obtenerlos en: Firebase Console > Configuración del proyecto > Tus apps
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Activar emuladores locales (requerido para desarrollo local con npm run dev:all)
# true  = Firebase Auth Emulator (localhost:9099) — usar en desarrollo
# false = Firebase producción — usar en producción / Railway
NEXT_PUBLIC_USE_EMULATOR=false

# Host del emulador de Firebase Auth (requerido cuando USE_EMULATOR=true)
# Necesario tanto para el cliente como para el Admin SDK (verificación de tokens server-side)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# -----------------------------------------------------------------------------
# Firebase Admin SDK (server-side — OBLIGATORIO para API routes)
# Obtenerlo en: Firebase Console > Configuración > Cuentas de servicio
# > Generar nueva clave privada (descarga un .json)
# Pegá todo el contenido del JSON como string (en una sola línea):
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=gestordetrabajo
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# -----------------------------------------------------------------------------
# MercadoPago (requerido para el módulo de suscripciones)
# Obtenerlo en: https://www.mercadopago.com.ar/developers/panel/app
# -----------------------------------------------------------------------------
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Cloudinary (requerido para subida de archivos adjuntos)
# Obtenerlo en: https://cloudinary.com/console
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Groq (requerido para "Dictar tareas" — transcripción de audio + extracción IA)
# Obtenerlo GRATIS en: https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

DATABASE_URL="postgresql://postgres:XCghGyCkBLVnahuATCoaNvnZMvsvxHzL@roundhouse.proxy.rlwy.net:PUERTO/railway"

# Emails con acceso superadmin (separados por coma)
SUPERADMIN_EMAILS=tu@email.com

RESEND_API_KEY=tu_api_key_de_resend
GMAIL_USER=tecnofusion.it@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxx 