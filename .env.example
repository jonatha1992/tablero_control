# =============================================================================
# TABLERO DE CONTROL — Variables de entorno
# Copiá este archivo a .env.local y completá los valores
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase (client-side — ya tienen fallbacks hardcodeados en client.ts)
# Obtenerlos en: Firebase Console > Configuración del proyecto > Tus apps
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Activar emuladores locales (requerido para desarrollo local con npm run dev:all)
# true  = Firebase Auth Emulator (localhost:9099) — usar en desarrollo
# false = Firebase producción — usar en producción / Railway
NEXT_PUBLIC_USE_EMULATOR=false

# Host del emulador de Firebase Auth (requerido cuando USE_EMULATOR=true)
# Necesario tanto para el cliente como para el Admin SDK (verificación de tokens server-side)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# -----------------------------------------------------------------------------
# Firebase Admin SDK (server-side — OBLIGATORIO para API routes)
# Obtenerlo en: Firebase Console > Configuración > Cuentas de servicio
# > Generar nueva clave privada (descarga un .json)
# Pegá todo el contenido del JSON como string (en una sola línea):
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=gestordetrabajo
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# -----------------------------------------------------------------------------
# MercadoPago (requerido para el módulo de suscripciones)
# Obtenerlo en: https://www.mercadopago.com.ar/developers/panel/app
# -----------------------------------------------------------------------------
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Cloudinary (requerido para subida de archivos adjuntos)
# Obtenerlo en: https://cloudinary.com/console
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Groq (requerido para "Dictar tareas" — transcripción de audio + extracción IA)
# Obtenerlo GRATIS en: https://console.groq.com/keys
# -----------------------------------------------------------------------------
# ─── Proveedores de IA ────────────────────────────────────────────────────
# Esquema unificado en todos los repos. Pegar las keys reales en .env (nunca acá).
#
# GEMINI — Google AI Studio. La cuota gratis se aplica POR PROYECTO, no por key
#   (https://ai.google.dev/gemini-api/docs/rate-limits). Varias keys del mismo
#   proyecto comparten el mismo límite: no suman. Para multiplicar cuota, cada
#   key debe salir de una cuenta/proyecto distinto. Acá usamos 5 cuentas.
#   Hoy son 7 keys de proyectos distintos. El colector canonico
#   (src/lib/ai/api-keys.ts) las junta y el pool rota ante 429/401/503.
#   GOOGLE_AI_API_KEY sigue leyendose como nombre legacy, pero no hace falta:
#   el esquema vigente es el numerado.
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_API_KEY5=
GEMINI_API_KEY6=
GEMINI_API_KEY7=
#
# GROQ — la cuota se aplica POR ORGANIZACIÓN, no por key
#   (https://console.groq.com/docs/rate-limits). Rotar entre keys de la MISMA
#   cuenta no gana nada. Estas dos son de cuentas distintas, por eso suman.
#   Free tier: 30 RPM; el RPD depende del modelo (llama-3.3-70b: 1K/día,
#   llama-3.1-8b: 14.4K/día, whisper-large-v3: 2K/día + 7.2K seg de audio/hora).
#   Ante 429 el pool respeta el header `retry-after` que devuelve Groq.
GROQ_API_KEY1=
GROQ_API_KEY2=
#
# NVIDIA NIM (build.nvidia.com) — último eslabón de la cadena de fallback.
#   Free tier: 40 RPM y créditos iniciales por cuenta. Una sola key, sin pool.
NVIDIA_API_KEY=

# -----------------------------------------------------------------------------
# Google AI / Gemini (requerido para adjuntar imagenes en el chat IA)
# Obtenerlo en: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------

DATABASE_URL="postgresql://postgres:<password>@<host>.proxy.rlwy.net:<puerto>/railway"

# Emails con acceso superadmin (separados por coma)
SUPERADMIN_EMAILS=tu@email.com

RESEND_API_KEY=tu_api_key_de_resend
RESEND_FROM_EMAIL=onboarding@resend.dev
GMAIL_USER=tecnofusion.it@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxx

# -----------------------------------------------------------------------------
# Cron jobs internos (instrumentation.ts)
# Sin esto, al arrancar verás: [cron] CRON_SECRET no configurado — cron jobs desactivados
# En local: cualquier string largo. En Railway: secret fuerte y único.
# -----------------------------------------------------------------------------
CRON_SECRET=local-dev-cron-secret-change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mail: sin dominio propio, comentá RESEND_API_KEY para forzar Gmail (GMAIL_USER).
# Con dominio verificado en Resend, descomentá RESEND_* y el sistema prioriza Resend.
 
