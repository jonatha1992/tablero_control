{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Full Stack: Backend + Frontend",
            "configurations": [
                "Backend: FastAPI",
                "Frontend: Vue Dev Server"
            ]
        }
    ],
    "configurations": [
        {
            "name": "Backend: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "envFile": "${workspaceFolder}/backend/.env",
            "env": {
                "PORT": "8010",
                "API_URL": "http://localhost:8010",
                "API_FRONTEND_DEV": "http://localhost:5180/"
            },
            "args": [
                "app.main:app",
                "--host=0.0.0.0",
                "--port=8010",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Frontend: Vue Dev Server",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/frontend",
            "env": {
                "PORT": "5180",
                "VUE_APP_API_URL": "http://localhost:8010"
            },
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outputCapture": "console",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}
