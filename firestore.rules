rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isAuthenticated() { return request.auth != null; }

    // Claims preferidos (seteados por Admin SDK). Fallback a users/{uid} si no existen.
    function claimRole() { return request.auth.token.role; }
    function claimBusiness() { return request.auth.token.businessId; }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return claimRole() != null ? claimRole() : userData().role;
    }

    function getBusinessId() {
      return claimBusiness() != null ? claimBusiness() : userData().businessId;
    }

    function isSuperAdmin() { return isAuthenticated() && getRole() == 'superadmin'; }
    function isAdmin()      { return isAuthenticated() && (getRole() == 'superadmin' || getRole() == 'admin'); }
    function isResponsable(){ return isAuthenticated() && (getRole() == 'superadmin' || getRole() == 'admin' || getRole() == 'responsable'); }
    function isOwner(userId){ return request.auth.uid == userId; }

    function sameTenant(businessId) {
      return isSuperAdmin() || (businessId != null && getBusinessId() == businessId);
    }

    function isActiveBusiness(businessId) {
      let b = get(/databases/$(database)/documents/businesses/$(businessId)).data;
      return b.status == 'active' || b.status == 'trial';
    }

    function isAssignedToTask(taskId) {
      let task = get(/databases/$(database)/documents/tasks/$(taskId)).data;
      return request.auth.uid in task.assigneeIds;
    }

    // ---------- Businesses ----------
    match /businesses/{businessId} {
      allow read:   if isAuthenticated() && sameTenant(businessId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isAdmin() && sameTenant(businessId));
      allow delete: if isSuperAdmin();

      // Subcolección de roles custom
      match /roles/{roleId} {
        allow read:   if isAuthenticated() && sameTenant(businessId);
        allow create: if isAdmin() && sameTenant(businessId);
        allow update: if isAdmin() && sameTenant(businessId) && resource.data.isSystem == false;
        allow delete: if isAdmin() && sameTenant(businessId) && resource.data.isSystem == false;
      }
    }

    // ---------- Users ----------
    match /users/{userId} {
      allow read:   if isAuthenticated() && (isOwner(userId) || isSuperAdmin() || (isAdmin() && sameTenant(resource.data.businessId)));
      allow create: if isSuperAdmin() || (isAdmin() && sameTenant(request.resource.data.businessId));
      allow update: if isOwner(userId) || isSuperAdmin() || (isAdmin() && sameTenant(resource.data.businessId));
      allow delete: if isSuperAdmin() || (isAdmin() && sameTenant(resource.data.businessId));
    }

    // ---------- Teams / Locations / Projects ----------
    match /teams/{teamId} {
      allow read:   if isAuthenticated() && sameTenant(resource.data.businessId);
      allow create: if isAdmin() && sameTenant(request.resource.data.businessId) && isActiveBusiness(request.resource.data.businessId);
      allow update: if isResponsable() && sameTenant(resource.data.businessId);
      allow delete: if isAdmin() && sameTenant(resource.data.businessId);
    }

    match /locations/{locationId} {
      allow read:   if isAuthenticated() && sameTenant(resource.data.businessId);
      allow create: if isAdmin() && sameTenant(request.resource.data.businessId) && isActiveBusiness(request.resource.data.businessId);
      allow update: if isResponsable() && sameTenant(resource.data.businessId);
      allow delete: if isAdmin() && sameTenant(resource.data.businessId);
    }

    match /projects/{projectId} {
      allow read:   if isAuthenticated() && sameTenant(resource.data.businessId);
      allow create: if isAdmin() && sameTenant(request.resource.data.businessId) && isActiveBusiness(request.resource.data.businessId);
      allow update: if isResponsable() && sameTenant(resource.data.businessId);
      allow delete: if isAdmin() && sameTenant(resource.data.businessId);
    }

    // ---------- Tasks ----------
    match /tasks/{taskId} {
      allow read:   if isAuthenticated() && sameTenant(resource.data.businessId);
      allow create: if isResponsable() && sameTenant(request.resource.data.businessId) && isActiveBusiness(request.resource.data.businessId);
      allow update: if sameTenant(resource.data.businessId) && (isResponsable() || isAssignedToTask(taskId));
      allow delete: if isResponsable() && sameTenant(resource.data.businessId);
    }

    // ---------- Reports / Alerts ----------
    match /reports/{reportId} {
      allow read:   if isAuthenticated() && sameTenant(resource.data.businessId);
      allow create: if isResponsable() && sameTenant(request.resource.data.businessId);
      allow update: if false;
      allow delete: if isAdmin() && sameTenant(resource.data.businessId);
    }

    match /alerts/{alertId} {
      allow read:   if isAuthenticated() && sameTenant(resource.data.businessId);
      allow create: if isResponsable() && sameTenant(request.resource.data.businessId);
      allow update: if isResponsable() && sameTenant(resource.data.businessId);
      allow delete: if isAdmin() && sameTenant(resource.data.businessId);
    }

    // ---------- Subscriptions (server-write only) ----------
    match /subscriptions/{subscriptionId} {
      allow read:   if isSuperAdmin() || (isAdmin() && sameTenant(resource.data.businessId));
      allow write:  if false; // solo Admin SDK (webhook MP / API routes)

      match /invoices/{invoiceId} {
        allow read:  if isSuperAdmin() || (isAdmin() && sameTenant(resource.data.businessId));
        allow write: if false;
      }
    }

    // ---------- Audit logs (server-write only) ----------
    match /auditLogs/{logId} {
      allow read:  if isSuperAdmin() || (isAdmin() && sameTenant(resource.data.businessId));
      allow write: if false;
    }

    // ---------- Agent logs ----------
    match /agentLogs/{logId} {
      allow read:  if isResponsable();
      allow write: if false;
    }
  }
}
