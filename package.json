{
  "name": "tablero_control",
  "version": "0.1.27",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:all": "concurrently \"npm run emulators:auth\" \"npm run dev\" --names \"firebase,next\" --prefix-colors \"yellow,cyan\"",
    "emulators": "firebase emulators:start --only auth",
    "emulators:auth": "firebase emulators:start --only auth",
    "emulators:clean": "firebase emulators:start --only auth",
    "prebuild": "tsx scripts/bump-version.ts",
    "build": "next build",
    "build:prod": "next build",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx src/test/seed.ts",
    "seed:pg": "tsx --env-file=.env.local scripts/seed-pg.ts",
    "seed:firebase": "tsx --env-file=.env.local scripts/seed-firebase-emulator.ts",
    "seed:demo-user": "tsx --env-file=.env.local scripts/create-demo-user.ts",
    "seed:invite-demo": "tsx --env-file=.env.local scripts/seed-invite-demo.ts",
    "seed:superadmin": "tsx --env-file=.env.local scripts/seed-superadmin.ts",
    "cleanup:invite-phantom-businesses": "tsx --env-file=.env.local scripts/cleanup-invite-phantom-businesses.ts",
    "seed:export": "firebase emulators:export ./firestore-seed",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type:check": "tsc --noEmit",
    "encoding:check": "node scripts/check-encoding.mjs",
    "check": "npm run encoding:check && npm run lint && npm run type:check && npm run knip && npm run test:run",
    "knip": "knip --no-exit-code",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/resource": "^6.1.20",
    "@fullcalendar/resource-timeline": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.7",
    "@tanstack/react-query": "^5.99.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "driver.js": "^1.4.0",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0",
    "groq-sdk": "^1.1.2",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "firebase-tools": "^15.14.0",
    "jsdom": "^29.0.2",
    "knip": "^6.7.0",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
