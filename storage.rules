rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function businessId() { return request.auth.token.businessId; }
    function isSuperAdmin() { return isAuthenticated() && role() == 'superadmin'; }

    // Límites
    function underMaxSize() { return request.resource.size < 10 * 1024 * 1024; } // 10 MB
    function allowedMime() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/msword')
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
          || request.resource.contentType.matches('text/.*');
    }

    // Avatares y archivos personales
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId
                   && underMaxSize()
                   && request.resource.contentType.matches('image/.*');
    }

    // Adjuntos de tareas: scoped por business
    match /businesses/{bid}/tasks/{taskId}/{allPaths=**} {
      allow read:  if isAuthenticated() && (isSuperAdmin() || businessId() == bid);
      allow write: if isAuthenticated() && businessId() == bid
                   && underMaxSize() && allowedMime();
    }

    // Legacy path (mantenido temporalmente; nuevo código usa /businesses/{bid}/tasks/...)
    match /tasks/{taskId}/{allPaths=**} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated() && underMaxSize() && allowedMime();
    }

    match /businesses/{bid}/projects/{projectId}/{allPaths=**} {
      allow read:  if isAuthenticated() && (isSuperAdmin() || businessId() == bid);
      allow write: if isAuthenticated() && businessId() == bid
                   && underMaxSize() && allowedMime();
    }

    match /businesses/{bid}/logo/{allPaths=**} {
      allow read: if true; // logo público
      allow write: if isAuthenticated() && businessId() == bid
                   && (role() == 'admin' || isSuperAdmin())
                   && underMaxSize()
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
